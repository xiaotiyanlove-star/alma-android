{
  "name": "alma-herdr-android",
  "version": "0.1.27",
  "private": true,
  "type": "module",
  "description": "Independent multi-host Herdr client in the nanami Android shell",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build:web": "tsc --noEmit && vite build",
    "build:web:dev": "tsc --noEmit && ALMA_APP_ID=local.almaandroid.herdr.dev vite build",
    "test": "tsx --test client-tests/*.test.ts",
    "check": "npm run test && npm run build:web",
    "android:sync": "npm run build:web && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:dev": "npm run build:web:dev && npx cap sync android && cd android && ./gradlew assembleDebug",
    "test:ui": "tsx client-tests/all.ts --skip-build",
    "test:all": "tsx client-tests/all.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/network": "^7.0.4",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}
