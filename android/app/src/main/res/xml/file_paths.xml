<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Only the app's own update directory is shareable. The upstream file listed
      external-path and cache-path roots (path="."), which put the whole external
      storage tree — DCIM, Downloads, other apps' files — inside the set a
      FileProvider URI could grant. Nothing here needs that, and the provider
      must not be able to hand out what it does not own.

      The `Download/` prefix is part of the path: UpdateDownloadService writes to
      `getExternalFilesDir(DIRECTORY_DOWNLOADS)/updates`, which is
      `<external-files>/Download/updates`, not `<external-files>/updates`.
      Without the prefix `getUriForFile` throws and the installer never opens.
    -->
    <external-files-path name="updates" path="Download/updates/" />
</paths>
