<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- windowBackground 显式对齐 renderer 底色（night 限定 #282c34）：
         原先继承 DayNight 默认且 android:background=@null —— splash 切换到
         WebView 首帧之间的空窗露出浅灰/白，暗色用户表现为启动白闪。 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <!-- 光标/选择手柄的 popup 底色。
             WebView 用 textSelectHandleWindowStyle 建手柄 PopupWindow，而本 App 的
             深色是网页里的 data-theme 决定的、Android 主题始终跟随系统，所以
             「网页深色 + 系统浅色」时手柄底下会露出系统浅色主题的一块白色方块。
             实测手柄窗口是从本主题取 android:background 当底色的（改 popupBackground
             无效），置透明后手柄图形自带形状，深浅两套下都只有手柄本身。 -->
        <item name="android:background">@android:color/transparent</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

</resources>
